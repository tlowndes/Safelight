{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for Safelight's windows: the main window plus capture's recording HUD, region picker and screenshot flash. Local plugins only.",
  "windows": ["main", "hud", "region", "flash"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-minimize",
    "core:window:allow-inner-position",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-available-monitors",
    "core:window:allow-primary-monitor",
    "core:window:allow-monitor-from-point",
    "core:window:allow-cursor-position",
    "core:event:allow-emit-to"
  ]
}
